{
  "uid": "bb-api-health",
  "title": "Baseball API — Service Health",
  "description": "Request traffic, errors, latency, and runtime health for the baseball-api service. Source of truth: docs/observability/dashboards/ in the repo.",
  "tags": ["baseball-api"],
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prom}" },
        "query": "label_values(target_info, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**How to read this board:** traffic and errors top-left, latency top-right, runtime health in the middle, recent warnings/errors at the bottom. Every log line and HTTP request is also a trace: to dig into one, copy a trace id from a log line (the `[hex]` block, also exported as the log's trace id) and open **Explore → Tempo**. If a panel is unexpectedly empty, see the README next to this dashboard's JSON in the repo (`docs/observability/dashboards/`)."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "HTTP requests per second reaching the API, split by route template. CORS preflights and swagger are excluded from traces but ARE included here (metrics are unfiltered).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error responses",
      "description": "Rate of 5xx (server bugs/outages — should be zero) and 4xx (mostly client noise: auth failures, bad requests) responses.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 25, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_response_status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request latency (all routes)",
      "description": "p50 = typical request, p95 = slow tail. Large uploads and media endpoints dominate the tail; check the per-route panel before assuming a regression.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "Which routes are slow. Only routes with traffic in the window appear.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (http_route, le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory (GC heap and committed)",
      "description": "GC-managed memory: heap in use (summed across generations) and memory the GC has committed from the OS. This understates the container's true working set (native memory, ffmpeg/imagemagick children are invisible here) — on .NET 8 the runtime instrumentation has no working-set metric. Steady heap growth across days = leak; sawtooth = normal GC.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_runtime_dotnet_gc_heap_size_bytes{job=~\"$service\"})",
          "legendFormat": "GC heap"
        },
        {
          "refId": "B",
          "expr": "process_runtime_dotnet_gc_committed_memory_size_bytes{job=~\"$service\"}",
          "legendFormat": "GC committed"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Thread pool pressure",
      "description": "Work items waiting for a thread-pool thread, plus lock contention. Queue length pinned above zero means the app can't keep up with incoming work (on .NET 8 there is no CPU metric from the runtime instrumentation; this is the closest saturation signal).",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_runtime_dotnet_thread_pool_queue_length{job=~\"$service\"}",
          "legendFormat": "queued work items"
        },
        {
          "refId": "B",
          "expr": "rate(process_runtime_dotnet_monitor_lock_contention_count_total{job=~\"$service\"}[$__rate_interval])",
          "legendFormat": "lock contention/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Exceptions and GC",
      "description": "Thrown exceptions per second (includes caught ones — a nonzero baseline is normal) and GC collections by generation.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_runtime_dotnet_exceptions_count_total{job=~\"$service\"}[$__rate_interval])",
          "legendFormat": "exceptions/s"
        },
        {
          "refId": "B",
          "expr": "sum by (generation) (rate(process_runtime_dotnet_gc_collections_count_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "GC {{generation}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent warnings and errors",
      "description": "All Warning+ log lines from the API. Click a line to expand it; the trace id links into Tempo when trace-to-logs is configured on the datasource.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"baseball-api\"} | detected_level=~\"warn|error|fatal\""
        }
      ]
    }
  ]
}
